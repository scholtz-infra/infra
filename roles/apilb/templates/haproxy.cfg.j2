# Managed by Ansible (roles/apilb).
# Every node talks to the Kubernetes API through 127.0.0.1:{{ kube_api_lb_port }}; HAProxy forwards to
# whichever control-plane nodes are healthy.
global
    log /dev/log local0
    maxconn 4000
    user haproxy
    group haproxy

defaults
    mode tcp
    log global
    option dontlognull
    timeout connect 5s
    timeout client 4h
    timeout server 4h

frontend kube_api
    bind 127.0.0.1:{{ kube_api_lb_port }}
    default_backend kube_api

backend kube_api
    option httpchk GET /readyz
    http-check expect status 200
    balance roundrobin
    default-server check check-ssl verify none inter 3s fall 3 rise 2
{% for host in groups['control_plane'] %}
    server {{ host }} {{ hostvars[host]['node_ip'] }}:6443
{% endfor %}
