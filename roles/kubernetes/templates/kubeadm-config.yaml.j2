# Managed by Ansible (roles/kubernetes). Used by "kubeadm init" on the first control-plane node.
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ node_ip }}
  bindPort: {{ kube_api_port }}
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: unix:///run/containerd/containerd.sock
  # control-plane nodes also run workloads
  taints: []
# Cilium replaces kube-proxy
skipPhases:
  - addon/kube-proxy
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {{ cluster_name }}
kubernetesVersion: v{{ kubernetes_version }}
controlPlaneEndpoint: {{ kube_api_internal_host }}:{{ kube_api_lb_port }}
networking:
  serviceSubnet: {{ service_cidr }}
apiServer:
  certSANs:
    - {{ kube_api_internal_host }}
    - 127.0.0.1
    - localhost
{% if kube_api_external_fqdn %}
    - {{ kube_api_external_fqdn }}
{% endif %}
  extraArgs:
    - name: authentication-config
      value: /etc/kubernetes/auth/authentication-config.yaml
  extraVolumes:
    - name: auth-config
      hostPath: /etc/kubernetes/auth
      mountPath: /etc/kubernetes/auth
      readOnly: true
      pathType: Directory
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
